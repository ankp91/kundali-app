# Main API key (Salesforce proxy) — used for all text/chat/interpretation
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_BASE_URL=

# Vision key — needed ONLY for the "Upload Kundali" feature
# The Salesforce proxy doesn't support image reading, so upload needs a direct Anthropic key.
# Get a free key at console.anthropic.com → API Keys
# Leave blank to disable upload feature (all other features still work)
ANTHROPIC_VISION_API_KEY=
